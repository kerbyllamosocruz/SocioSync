{
  "manifest_version": 3,
  "name": "BeeTok Automation Helper",
  "version": "4.2",
  "description": "Automates SocialBee profile connections, caption variations, and fast cross-tab TikTok OTP synchronization.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://app.socialbee.com/*",
    "https://app.socialbee.io/*",
    "https://*.kuku.lu/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*",
        "https://app.socialbee.com/*",
        "https://app.socialbee.io/*",
        "https://*.kuku.lu/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
